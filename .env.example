# Qdrant CRUD & Search API
PORT=8003
NODE_ENV=production

# Qdrant server
QDRANT_URL=http://127.0.0.1:6333
# Set only if Qdrant authentication is enabled
QDRANT_API_KEY=

# Python embedding API
EMBEDDING_API_URL=http://127.0.0.1:8002

# Must match the embedding model output dimension exactly
DEFAULT_COLLECTION=ai_centizen
DEFAULT_VECTOR_SIZE=1024
DEFAULT_VECTOR_DISTANCE=Cosine
