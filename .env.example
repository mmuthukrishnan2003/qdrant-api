# Application identity
APP_NAME="Qdrant Vector DB & AI"

# Qdrant CRUD & Search API
PORT=8003
NODE_ENV=production

# Qdrant server (local)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Python embedding API (local)
EMBEDDING_API_URL=http://127.0.0.1:8002

# Local vLLM / OpenAI-compatible LLM server
VLLM_API_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=default

# Default collection & vector settings
DEFAULT_COLLECTION=ai_centizen
DEFAULT_VECTOR_SIZE=1024
DEFAULT_VECTOR_DISTANCE=Cosine
